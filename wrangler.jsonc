{
  // LawDB.ca: static site + Worker API + D1 database.
  // The Worker name here must match the Cloudflare project name exactly.
  "name": "lawdb",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    // Static files are served directly (free, fast). Only /api/* runs the Worker.
    "run_worker_first": ["/api/*"]
  },
  // Non-secret settings. Secrets (BREVO_API_KEY, ADMIN_EMAILS) are set in the Cloudflare dashboard:
  // Workers & Pages -> lawdb -> Settings -> Variables and Secrets.
  "vars": {
    "SITE_ORIGIN": "https://lawdb.ca",
    "MAIL_FROM_EMAIL": "info@lawdb.ca",
    "MAIL_FROM_NAME": "LawDB"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lawdb",
      "database_id": "87085627-1c4b-40f3-b48c-d75e23089c18"
    }
  ]
}
