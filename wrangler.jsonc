{
  // LawDB.ca: static site + Worker API + D1 database.
  // The Worker name here must match the Cloudflare project name exactly.
  "name": "lawdb",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Static files are served directly (free, fast). The Worker only runs for the API, the three data
    // files, and the pages that embed the firm list (find-lawyers, the province/city hubs): for those it
    // swaps in the live database list, falling back to the static file if the database is unavailable.
    "run_worker_first": [
      "/api/*",
      "/firms_data.json", "/blog_data.json", "/firms_hours.json",
      "/find-lawyers",
      "/firms/*",
      "/report-listing",
      "/news", "/news/*", "/sitemap-news.xml", "/*.html",
      "/img/*",
      "/alberta/", "/manitoba/",
      "/ontario/*/", "/quebec/*/", "/british-columbia/*/", "/alberta/*/", "/manitoba/*/"
    ]
  },
  // Non-secret settings. Secrets (BREVO_API_KEY, ADMIN_EMAILS) are set in the Cloudflare dashboard:
  // Workers & Pages -> lawdb -> Settings -> Variables and Secrets.
  "vars": {
    "SITE_ORIGIN": "https://lawdb.ca",
    "MAIL_FROM_EMAIL": "info@lawdb.ca",
    "MAIL_FROM_NAME": "LawDB",
    // The Featured plan (CAD $199/month). Owners reach it from their dashboard with their firm and email attached.
    "STRIPE_PAYMENT_LINK": "https://buy.stripe.com/4gM7sN2X7d8naOFe0dfbq01"
  },
  // Nightly at 07:17 UTC: housekeeping (retention rules) and a backup of every table into the KV store below.
  "triggers": { "crons": ["17 7 * * *", "37 7 * * *"] },
  "kv_namespaces": [
    { "binding": "BACKUPS", "id": "d2894d66a6b349b0b5af16b94f096575" }
  ],
  // Firm pictures (private bucket; served to the public only through /img/<id>).
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "lawdb-images" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lawdb",
      "database_id": "87085627-1c4b-40f3-b48c-d75e23089c18"
    }
  ]
}
